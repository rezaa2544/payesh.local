<?xml version="1.0" encoding="utf-8"?>
<!-- شبکهٔ مدرسه معمولاً HTTP است؛ بنابراین cleartext برای دامنه‌های محلی مجاز می‌شود -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

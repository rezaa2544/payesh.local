{
 "id": "outbox-v1",
 "version": 1,
 "description": "Shared conformance vectors for the device outbox. Runs against client/outbox-web.js (tests/conformance-outbox-71.js) and apps/payesh/packages/payesh_sync (Dart, test/outbox_conformance_test.dart). jitter=0 makes backoff deterministic; 'now' is epoch milliseconds. drain.script lists the server answer per batch ({applied,rejected,conflicts} uid lists, or {throw:<message>}).",
 "cases": [
  {
   "name": "enqueue is idempotent on k and the queue is FIFO by seq",
   "config": {
    "capacity": 3,
    "leaseMs": 30000,
    "maxAttempts": 3,
    "baseBackoffMs": 1000,
    "maxBackoffMs": 5000,
    "jitter": 0,
    "batchLimit": 2
   },
   "steps": [
    {
     "op": "enqueue",
     "input": {
      "k": "a",
      "collection": "attendance",
      "type": "put",
      "at": "2026-11-01T08:00:00.000Z",
      "data": {
       "student_id": 1,
       "status": "present"
      }
     },
     "expect": {
      "ok": true,
      "duplicate": false
     }
    },
    {
     "op": "enqueue",
     "input": {
      "k": "b",
      "collection": "attendance",
      "type": "put",
      "at": "2026-11-01T08:00:00.000Z",
      "data": {
       "student_id": 2
      }
     },
     "expect": {
      "ok": true,
      "duplicate": false
     }
    },
    {
     "op": "enqueue",
     "input": {
      "k": "a",
      "collection": "attendance",
      "type": "put",
      "at": "2026-11-01T08:00:00.000Z",
      "data": {
       "student_id": 99
      }
     },
     "expect": {
      "ok": true,
      "duplicate": true
     }
    },
    {
     "op": "list",
     "expect_keys": [
      "a",
      "b"
     ]
    },
    {
     "op": "claim",
     "limit": 10,
     "now": 1000,
     "expect_keys": [
      "a",
      "b"
     ]
    },
    {
     "op": "stats",
     "expect": {
      "total": 2,
      "pending": 0,
      "inflight": 2,
      "blocked": 0,
      "active": 2,
      "full": false
     }
    }
   ]
  },

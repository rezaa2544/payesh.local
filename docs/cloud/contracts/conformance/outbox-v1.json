  {
   "name": "row 119: FIFO barrier — a later op never overtakes an earlier op in backoff",
   "config": {
    "capacity": 10,
    "leaseMs": 30000,
    "maxAttempts": 3,
    "baseBackoffMs": 1000,
    "maxBackoffMs": 4000,
    "jitter": 0,
    "batchLimit": 5
   },
   "steps": [
    {
     "op": "enqueue",
     "input": {
      "k": "cls",
      "collection": "classes",
      "type": "put",
      "at": "2026-11-11T08:00:00.000Z",
      "data": {}
     },
     "expect": {
      "ok": true,
      "duplicate": false
     }
    },
    {
     "op": "claim",
     "limit": 5,
     "now": 0,
     "expect_keys": [

     ]
    },
    {
     "op": "fail",
     "k": "cls",
     "now": 0,
     "error": "offline",
     "transient": true,
     "expect": {
      "state": "pending",
      "attempts": 1,
      "next_at": 1000
     }
    },
    {
     "op": "enqueue",
     "input": {
      "k": "stu",
      "collection": "students",
      "type": "put",
      "at": "2026-11-11T08:00:00.000Z",
      "data": {}
     },
     "expect": {
      "ok": true,
      "duplicate": false
     }
    },
    {
     "op": "claim",
     "limit": 5,
     "now": 500,
     "expect_keys": []
    },
    {
     "op": "claim",
     "limit": 5,
     "now": 1000,
     "expect_keys": [
      "cls",
      "stu"
     ]
    }
   ]

  {
   "name": "exponential backoff capped at maxBackoff; maxAttempts → blocked; retry resets",
   "config": {
    "capacity": 3,
    "leaseMs": 30000,
    "maxAttempts": 5,
    "baseBackoffMs": 1000,
    "maxBackoffMs": 3000,
    "jitter": 0,

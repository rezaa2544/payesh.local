     "data": {
      "id": 3,
      "class_id": 4,
      "role": "admin"
     },
     "refFields": [
      "role"
     ],
     "updated_at": "2026-11-01T08:00:00.000Z"
    },
    {
     "op": "get",
     "collection": "users",

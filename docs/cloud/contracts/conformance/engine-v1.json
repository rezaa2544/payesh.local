      "k": "users/3",
      "collection": "users",
      "id": 3,
      "data": {
       "id": 3,
       "class_id": 4,
       "role": "admin"
      },
      "version": 1,
      "updated_at": "2026-11-01T08:00:00.000Z",
      "refKeys": [
       "role:admin"
      ]
     }
    }
   ]

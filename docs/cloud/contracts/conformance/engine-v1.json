{
 "id": "engine-v1",
 "version": 1,
 "description": "Shared conformance vectors for the client data engine. The same file runs against client/engine-web.js (IndexedDB, tests/conformance-engine.js) and apps/payesh/packages/payesh_data (SQLite, Dart). Each case starts from an empty store. 'expect' compares the full row (refKeys compared as a sorted set); 'expect_ids' compares the ordered id list.",
 "row_shape": [
  "k",
  "collection",
  "id",
  "data",
  "version",
  "refKeys",
  "updated_at"
 ],
 "cases": [
  {
   "name": "put then get returns the stored row with derived k/refKeys",
   "steps": [
    {
     "op": "put",
     "collection": "attendance",
     "id": 7,
     "data": {
      "id": 7,
      "class_id": 3,
      "student_id": 12,
      "status": "present"
     },
     "updated_at": "2026-11-01T08:00:00.000Z"
    },
    {
     "op": "get",
     "collection": "attendance",
     "id": 7,
     "expect": {
      "k": "attendance/7",
      "collection": "attendance",
      "id": 7,
      "data": {
       "id": 7,
       "class_id": 3,
       "student_id": 12,
       "status": "present"
      },
      "version": 1,
      "updated_at": "2026-11-01T08:00:00.000Z",
      "refKeys": [
       "class_id:3",
       "id:7",
       "student_id:12"
      ]
     }
    },
    {
     "op": "get",
     "collection": "attendance",
     "id": 8,
     "expect": null
    },
    {
     "op": "count",
     "collection": "attendance",
     "expect": 1
    },
    {
     "op": "count",
     "collection": null,
     "expect": 1
    }
   ]
  },
  {
   "name": "put overwrites by k (collection/id) and keeps one row",
   "steps": [
    {
     "op": "put",
     "collection": "grades",
     "id": 1,
     "data": {
      "score": 10
     },
     "version": 1,
     "updated_at": "2026-11-01T08:00:00.000Z"
    },
    {
     "op": "put",
     "collection": "grades",
     "id": 1,
     "data": {
      "score": 19.5
     },
     "version": 2,
     "updated_at": "2026-11-01T09:00:00.000Z"
    },
    {
     "op": "get",
     "collection": "grades",
     "id": 1,
     "expect": {
      "k": "grades/1",
      "collection": "grades",
      "id": 1,
      "data": {
       "score": 19.5
      },
      "version": 2,
      "updated_at": "2026-11-01T09:00:00.000Z",
      "refKeys": []
     }
    },
    {
     "op": "count",
     "collection": "grades",
     "expect": 1
    }
   ]
  },
  {
   "name": "refKeys skip null and object values; explicit refFields override",
   "steps": [
    {
     "op": "put",
     "collection": "users",
     "id": 2,
     "data": {
      "id": 2,
      "school_id": null,
      "meta_id": {
       "x": 1
      },
      "role": "teacher",
      "class_id": "9a"

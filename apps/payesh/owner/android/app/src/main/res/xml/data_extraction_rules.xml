<?xml version="1.0" encoding="utf-8"?>
<!-- Row 72: no cloud backup and no device-to-device transfer of app data
     (secure-store ciphertext, encrypted DB). Data is re-pulled from the server after login. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

{
  "openapi": "3.0.3",
  "info": {
    "title": "Payesh Owner Panel Platform API",
    "version": "1.0.0",
    "description": "API مستقل پنل مالک. احراز و نقش کاملاً جدا از API مدرسه است؛ محتوا بهطور پیشفرض رد است و تنها با grant فعال content_read، یک رکورد و ثبت log خوانده میشود. وضعیت امنیتی سامانه UNKNOWN است تا پنتست انسانی مالک انجام شود."
  },
  "servers": [{ "url": "/api/platform/v1" }],
  "security": [{ "PlatformToken": [] }],
  "x-default-deny": true,
  "x-output-allowlist": "فیلدهای national_id، password_*، token/secret/authorization/cookie در هیچ پاسخی مجاز نیستند.",
  "components": {
    "securitySchemes": {
      "PlatformToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "platform.v1.<body>.<HMAC-SHA256>; separate secret from school tokens"
      }
    },
    "parameters": {
      "TenantId": { "name": "tenant_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "RequestId": { "name": "X-Request-Id", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 80 } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "enum": [false] },
          "error": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/health/summary": {
      "get": { "summary": "وضعیت پیکربندی namespace (بدون داده)", "security": [], "responses": { "200": { "description": "ok" } } }
    },
    "/openapi.json": {
      "get": { "summary": "همین قرارداد", "security": [], "responses": { "200": { "description": "OpenAPI document" } } }
    },
    "/auth/login": {
      "post": { "summary": "ورود انسانی پنل مالک (D-45): رمز + TOTP اجباری؛ حداکثر ۳ حساب؛ تکرار کد TOTP رد؛ ۵ شکست ⇒ قفل ۱۵ دقیقه؛ سهمیه بر اساس شناسه و IP", "security": [], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["login_id", "password", "totp"], "properties": { "login_id": { "type": "string", "maxLength": 120 }, "password": { "type": "string", "maxLength": 256 }, "totp": { "type": "string", "pattern": "^[0-9]{6}$" } } } } } }, "responses": { "200": { "description": "platform.v1 token (8h), expires_at, user {id, role}" }, "400": { "description": "invalid_login_request" }, "401": { "description": "invalid_credentials (یکسان برای حساب ناموجود/رمز/کد/تکرار/قفل/غیرفعال)" }, "429": { "description": "rate_limited" }, "501": { "description": "login_not_installed (migration 004 اجرا نشده)" }, "503": { "description": "not_configured / rate_limit_unavailable / login_unavailable" } } }
    },
    "/dashboard": {
      "get": { "summary": "شمارش فراداده (بدون محتوای مدرسه)", "responses": { "200": { "description": "ok" }, "401": { "description": "unauthorized" }, "429": { "description": "rate_limited" } } }
    },
    "/tenants": {
      "get": { "summary": "فهرست فرادادهٔ اشتراک مدارس", "responses": { "200": { "description": "ok" }, "401": { "description": "unauthorized" } } },
      "post": { "summary": "ساخت مدرسه (ردیف ۱۲۱)؛ فقط platform_owner با reason و provision_op_id؛ tenant اختصاصی + مدیر اولیه + کد فعال‌سازی یک‌بارمصرف", "responses": { "201": { "description": "created" }, "200": { "description": "idempotent replay (same provision_op_id)" }, "400": { "description": "invalid_input / reason_too_short" }, "403": { "description": "role_forbidden / forbidden" }, "409": { "description": "conflict (slug or op reused)" }, "502": { "description": "school_provisioning_failed (retry with the same provision_op_id)" }, "503": { "description": "school_provisioning_not_configured" } } }
    },
    "/tenants/{tenant_id}": {
      "get": { "summary": "فرادادهٔ یک مدرسه", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "responses": { "200": { "description": "ok" }, "404": { "description": "tenant_not_found" } } },
      "delete": { "summary": "همیشه رد میشود؛ حذف فوری مجاز نیست — گردش دومرحلهای deletion-request را ببینید", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "responses": { "403": { "description": "tenant_deletion_disabled" } } }
    },
    "/tenants/{tenant_id}/limits": {
      "get": { "summary": "سقفهای مدرسه", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "responses": { "200": { "description": "ok" } } }
    },
    "/tenants/{tenant_id}/usage": {
      "get": { "summary": "مصرف مدرسه", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "responses": { "200": { "description": "ok" } } }
    },
    "/tenants/{tenant_id}/content": {
      "get": { "summary": "همیشه رد میشود؛ فهرست/خروجیگیری انبوه محتوا تعریف نشده است", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "responses": { "403": { "description": "bulk_content_forbidden" } } }
    },
    "/tenants/{tenant_id}/content/{collection}/{record_ref}": {
      "get": {
        "summary": "خواندن دقیقاً یک رکورد محتوا، فقط با grant فعال content_read؛ هر خواندن یک support_access_log میسازد",
        "parameters": [
          { "$ref": "#/components/parameters/TenantId" },
          { "name": "collection", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" } },
          { "name": "record_ref", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{1,18}$" } }
        ],
        "responses": { "200": { "description": "ok" }, "400": { "description": "invalid_record_reference" }, "403": { "description": "grant_required / forbidden" } }
      }
    },
    "/plans": {
      "get": { "summary": "فهرست طرحها", "responses": { "200": { "description": "ok" } } },
      "post": { "summary": "ساخت طرح؛ فقط platform_owner", "responses": { "201": { "description": "created" }, "400": { "description": "invalid_input" }, "403": { "description": "role_forbidden" } } }
    },
    "/subscriptions": {
      "get": { "summary": "فهرست اشتراکها", "responses": { "200": { "description": "ok" } } }
    },
    "/subscriptions/{subscription_id}/renew": {
      "post": { "summary": "تمدید/فعالسازی؛ فقط platform_owner. اپراتور ۴۰۳ میگیرد.", "parameters": [{ "name": "subscription_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "ok" }, "403": { "description": "role_forbidden" } } }
    },
    "/tenants/{tenant_id}/suspend": {
      "post": { "summary": "تعلیق با دلیل ≥۱۰ نویسه؛ مالک یا اپراتور", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "responses": { "200": { "description": "ok" }, "400": { "description": "reason_too_short" } } }
    },
    "/platform-users": {
      "get": { "summary": "فهرست هویتهای پلتفرم (بدون رمز/توکن)", "responses": { "200": { "description": "ok" } } },
      "post": { "summary": "ثبت هویت پلتفرم؛ فقط platform_owner", "responses": { "201": { "description": "created" }, "403": { "description": "role_forbidden" } } }
    },
    "/support-grants": {
      "get": { "summary": "فهرست grantها", "responses": { "200": { "description": "ok" } } },
      "post": { "summary": "درخواست grant؛ فقط اپراتور/پشتیبانی، scope=metadata|content_read، دلیل ≥۱۰ نویسه، ≤۷۲ ساعت، اطلاع مدرسه پیش از شروع", "responses": { "201": { "description": "pending" }, "400": { "description": "invalid_scope / invalid_input" }, "403": { "description": "role_forbidden" } } }
    },
    "/support-grants/{request_id}/approve": {
      "post": { "summary": "تأیید توسط مالک فعال غیر از درخواستکننده (چهارچشم)", "parameters": [{ "name": "request_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "ok" }, "403": { "description": "role_forbidden / forbidden" } } }
    },
    "/support-grants/{grant_id}/revoke": {
      "post": { "summary": "ابطال grant؛ فقط مالک؛ غیرقابلتمدید", "parameters": [{ "name": "grant_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "ok" }, "403": { "description": "role_forbidden" } } }
    },
    "/audit": {
      "get": { "summary": "فرادادهٔ زنجیرهٔ هش حسابرسی", "responses": { "200": { "description": "ok" } } }
    },
    "/tenant-deletions": {
      "get": { "summary": "فهرست درخواستهای حذف مدرسه؛ فقط owner", "responses": { "200": { "description": "ok" }, "403": { "description": "role_forbidden" } } }
    },
    "/tenants/{tenant_id}/deletion-request": {
      "post": { "summary": "درخواست حذف توسط owner؛ دلیل ≥۱۰ نویسه و تکرار شناسهٔ مدرسه", "parameters": [{ "$ref": "#/components/parameters/TenantId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["reason", "confirm_tenant_id"], "properties": { "reason": { "type": "string", "minLength": 10 }, "confirm_tenant_id": { "type": "string", "format": "uuid" } } } } } }, "responses": { "201": { "description": "pending" }, "400": { "description": "reason_too_short / confirm_mismatch" }, "403": { "description": "role_forbidden / forbidden" }, "409": { "description": "conflict — درخواست باز دیگری برای همین مدرسه هست" } } }
    },
    "/tenant-deletions/{request_id}/approve": {
      "post": { "summary": "تأیید توسط owner دوم (≠ درخواستکننده)؛ not_before = زمان تأیید + ۲۴ ساعت", "parameters": [{ "name": "request_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "approved" }, "403": { "description": "role_forbidden / four_eyes_required / forbidden" }, "404": { "description": "request_not_found" } } }
    },
    "/tenant-deletions/{request_id}/cancel": {
      "post": { "summary": "لغو درخواست باز توسط هر owner با دلیل", "parameters": [{ "name": "request_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 10 } } } } } }, "responses": { "200": { "description": "canceled" }, "400": { "description": "reason_too_short" }, "403": { "description": "role_forbidden / forbidden" }, "404": { "description": "request_not_found" } } }
    },
    "/tenant-deletions/{request_id}/execute": {
      "post": { "summary": "پس از تأیید و پایان ۲۴ ساعت: لغو اشتراکها + retain_until ≥ ۱۸۰ روز؛ هیچ دادهای نابود نمیشود (D-22)", "parameters": [{ "name": "request_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "executed, data_destroyed=false" }, "403": { "description": "role_forbidden / forbidden" }, "404": { "description": "request_not_found" }, "409": { "description": "deletion_delay_pending" } } }
    },
    "/infra": {
      "get": { "summary": "ردیف ۱۲۲ — نمای زیرساخت: providerها (فقط مرجع credential، هرگز مقدار)، سرویس‌ها با معیارهای برچسب‌دار (بدون داده = unknown/?)، endpointها با آخرین Health Check، هشدارهای باز", "responses": { "200": { "description": "ok (provisioning.automated=false)" }, "401": { "description": "unauthorized" } } }
    },
    "/infra/providers": {
      "post": { "summary": "ثبت دستی provider (host/vps/vpc/db/storage/other)؛ api_mode فقط manual؛ credential فقط به‌صورت secret:NAME", "responses": { "201": { "description": "registered" }, "400": { "description": "credentials_not_accepted / credential_must_be_reference / invalid_input" }, "403": { "description": "role_forbidden / forbidden" }, "409": { "description": "conflict (code)" }, "501": { "description": "provider_api_not_implemented" } } }
    },
    "/infra/services": {
      "post": { "summary": "ثبت دستی سرویس زیر یک provider فعال", "responses": { "201": { "description": "registered" }, "400": { "description": "invalid_provider_id / invalid_input" }, "403": { "description": "role_forbidden / forbidden" }, "409": { "description": "conflict" } } }
    },
    "/infra/endpoints": {
      "post": { "summary": "ثبت endpoint برای Health Check محدود (http(s) یا tcp، بدون user:password)", "responses": { "201": { "description": "registered" }, "400": { "description": "invalid_endpoint / invalid_service_id" }, "403": { "description": "role_forbidden / forbidden" }, "409": { "description": "conflict" } } }
    },
    "/infra/endpoints/{endpoint_id}/check": {
      "post": { "summary": "یک Health Check دستی (timeout، بدون redirect، بدون بدنه، آدرس خصوصی رد)؛ ۳ شکست پیاپی = هشدار + audit", "parameters": [{ "name": "endpoint_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "checked (ok true/false)" }, "404": { "description": "endpoint_not_found" }, "409": { "description": "endpoint_disabled" }, "429": { "description": "check_cooldown / rate_limited" } } }
    },
    "/infra/metrics": {
      "post": { "summary": "ثبت معیار ظرفیت/مصرف/خطا با برچسب M یا E؛ بدون مقدار = ?؛ provider_api تا ردیف ۱۲۴ رد", "responses": { "201": { "description": "recorded" }, "400": { "description": "label_required / invalid_input" }, "403": { "description": "role_forbidden / forbidden" }, "501": { "description": "provider_api_not_implemented" } } }
    },
    "/infra/changes": {
      "get": { "summary": "درخواست‌های تغییر پرخطر زیرساخت", "responses": { "200": { "description": "ok" }, "401": { "description": "unauthorized" } } },
      "post": { "summary": "درخواست تغییر پرخطر (غیرفعال/فعال‌سازی provider، تغییر مرجع credential، غیرفعال‌سازی endpoint)؛ اجرا فقط پس از تأیید owner", "responses": { "201": { "description": "pending" }, "400": { "description": "invalid_action / reason_too_short / credential_must_be_reference / credentials_not_accepted" }, "403": { "description": "role_forbidden / forbidden" } } }
    },
    "/infra/changes/{request_id}/approve": {
      "post": { "summary": "تأیید و اجرای یک‌بارهٔ تغییر پرخطر؛ فقط platform_owner؛ audit", "parameters": [{ "name": "request_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "executed" }, "403": { "description": "role_forbidden / forbidden (not pending, not owner)" } } }
    }
  }
}

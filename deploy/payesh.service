[Unit]
Description=Payesh — سامانهٔ مدرسه (نمونهٔ سرویس)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=payesh
Group=payesh
WorkingDirectory=/opt/payesh
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=PAYESH_DATA=/opt/payesh/data
Environment=PAYESH_TUNNEL_AUTO=0
# اگر دامنه دارید:
# Environment=PAYESH_PUBLIC_URL=https://payesh.example.ir
ExecStart=/usr/bin/node --experimental-sqlite --disable-warning=ExperimentalWarning server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/payesh/data

[Install]
WantedBy=multi-user.target

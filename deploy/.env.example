# نمونهٔ متغیرهای محیطی برای استقرار «پایش» روی میزبان همیشه‌روشن
# این فایل را به .env کپی کنید یا همان‌ها را در پنل میزبانی وارد کنید.

# درگاهی که میزبان می‌دهد (روی بیشتر پنل‌ها خودش تنظیم می‌شود؛ اگر آزاد است ۸۰۸۰)
PORT=8080

# مسیر دادهٔ ماندگار — هرگز /tmp نباشد
PAYESH_DATA=/opt/payesh/data

# آدرس عمومی نهایی (همان دامنه/زیردامنه‌ای که کاربران باز می‌کنند)
PAYESH_PUBLIC_URL=https://payesh.example.ir

# روی ابر به تونل نیازی نیست
PAYESH_TUNNEL_AUTO=0

# (اختیاری) آینهٔ ابری برای دیدن وضعیت وقتی سیستم مدرسه خاموش است
# PAYESH_HUB_URL=
# PAYESH_HUB_ENABLED=1

# ردیف ۸۷ — رمزنگاری فیلدیِ دادهٔ حساس (کد ملی، یادداشت مشاور) با AES-256-GCM.
# کلید فقط این‌جا/پنل میزبان (یا KMS) — هرگز در مخزن. ساخت کلید:
#   node tools/field-rekey-87.mjs --new-key
# قالب: kid:base64(32 بایت)؛ اولین کلید فعال است، بقیه فقط برای چرخش.
# PAYESH_FIELD_KEYS=
# با required، بدون کلید سرور بالا نمی‌آید (توصیه برای تولید):
# PAYESH_FIELD_CRYPTO=required

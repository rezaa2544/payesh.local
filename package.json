{
  "name": "payesh-local",
  "version": "0.8.55",
  "private": true,
  "description": "پایش-لوکال — سامانهٔ مدیریت مدرسه، درون‌مدرسه‌ای و آفلاین (Node + SQLite)",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/start.js",
    "dev": "node server/start.js",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning server/seed.js --fresh",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "check": "node --check server/index.js && node --check server/db.js && node --check server/start.js && node --check server/auth.js && node --check server/sync.js && node --check server/policy.js && node --check server/archive.js && node --check client/app.js && node --check client/pages.js && node --check client/import.js && node --check client/schedule.js && node --check client/secure-web.js && node --check client/engine-web.js && node --check client/outbox-web.js && node --check client/sw.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/run.js",
    "build:release": "node scripts/build-release.mjs",
    "test:ui": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/ui.js",
    "test:flow": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/flow.js",
    "test:update": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/update.js",
    "test:tunnel": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/tunnel.js",
    "lint:iss": "node scripts/lint-iss.mjs",
    "bundle:cloud": "node scripts/build-cloud-bundle.mjs",
    "selfcheck": "node deploy/selfcheck.mjs",
    "bake:cloud": "node scripts/bake-cloud.mjs",
    "test:phone": "node tests/phone-flow.js",
    "test:restart": "node tests/restart.js",
    "test:live": "node tests/live.js",
    "test:contract": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/sync-contract.js",
    "test:contract:client": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/sync-client-contract.js",
    "test:model": "node tools/cost-model.cjs > /dev/null && node tests/cost-model.js",
    "test:boundary": "node tests/repo-boundary.js",
    "test:feed": "bash docs/cloud/reports/evidence/run-36-change-feed.sh",
    "test:gateway": "bash docs/cloud/reports/evidence/run-37-gateway.sh",
    "test:scope": "bash docs/cloud/reports/evidence/run-38-scope.sh",
    "test:directory": "bash docs/cloud/reports/evidence/run-43-directory.sh",
    "test:engine": "node tests/engine-web.js",
    "test:secure": "node tests/secure-web.js",
    "test:revocation": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/revocation-44.js",
    "test:security44": "bash docs/cloud/reports/evidence/run-44-security.sh",
    "test:outbox40": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/outbox-40.js",
    "test:outbox40:evidence": "bash docs/cloud/reports/evidence/run-40-outbox.sh",
    "test:archive53": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/archive-53.js",
    "archive:sizes": "node --experimental-sqlite --disable-warning=ExperimentalWarning tools/archive-53-sizes.js",
    "test:archive53:evidence": "bash docs/cloud/reports/evidence/run-53-archive.sh",
    "bench:39": "node tools/serve-bench.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.7",
    "java-parser": "^3.0.0",
    "jsdom": "^25.0.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
